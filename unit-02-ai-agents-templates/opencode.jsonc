{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "provider": {
    "local-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Qwen3.8-27B (256K Private)",
      "options": {
        "baseURL": "http://127.0.0.1:18120/v1",
        "apiKey": "<LOCAL_OR_YOUR_API_KEY>"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B (local 256K)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    },
    "scnet-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "国家超算互联网 SCNet LLM 网关",
      "options": {
        "baseURL": "https://api.scnet.cn/api/llm/v1",
        "apiKey": "<YOUR_SCNET_API_KEY>"
      },
      "models": {
        "DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek-V4.1-Flash-1017"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
